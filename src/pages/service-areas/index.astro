---
import Contact from '../../components/sections/Contact.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import Faq from '../../components/sections/Faq.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Process from '../../components/sections/Process.astro';
import QuickQuote from '../../components/sections/QuickQuote.astro';
import Services from '../../components/sections/Services.astro';
import Icon from '../../components/ui/Icon.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { areaPath, getFaqs, getOrdered } from '../../lib/content';
import { breadcrumbSchema, faqSchema } from '../../lib/seo';

const title = `HVAC Service Areas in Northern Virginia | ${site.name}`;
const description =
  'ARYA Heating & Cooling serves Ashburn and communities across Northern Virginia with 24/7 heating and cooling repair, maintenance and installation.';

const trail = [
  { name: 'Home', href: '/' },
  { name: 'Service Areas', href: '/service-areas/' },
];

const areas = await getOrdered('areas');
const faqs = await getFaqs('service-areas');
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  breadcrumbSchema(
    trail.map((item) => ({ name: item.name, url: new URL(item.href, Astro.site).href })),
    pageUrl
  ),
  faqSchema(faqs, pageUrl),
];

const cardClass = 'flex items-center gap-3 rounded-[14px] border border-line bg-white px-4 py-3.5 text-[15px] font-semibold text-ink';
---

<Layout title={title} description={description} pageType="CollectionPage" schema={schema}>
  <PageHero
    title="Service Areas"
    description="Heating and cooling service for Ashburn and communities across Northern Virginia, 24 hours a day, 7 days a week."
    trail={trail}
  />
  <QuickQuote overlap={false} />

  <section class="bg-soft py-17 md:py-24" id="areas">
    <div class="wrap">
      <SectionHeading
        eyebrow="Where We Work"
        title="Communities We Serve in Northern Virginia"
        description={`Our Master Licensed technicians cover ${areas.length} communities. Call us if you don't see yours.`}
      />
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {
          areas.map((area) => (
            <li>
              {areaPath(area) ? (
                <a
                  href={areaPath(area)}
                  class:list={[cardClass, 'group justify-between transition duration-200 hover:border-transparent hover:shadow-card']}
                >
                  <span class="flex items-center gap-3">
                    <Icon name="pin" class="size-4.5 flex-none text-brand" />
                    {area.data.name}
                  </span>
                  <Icon
                    name="arrow"
                    class="size-4.5 flex-none text-brand transition-transform duration-200 group-hover:translate-x-1"
                  />
                </a>
              ) : (
                <span class={cardClass}>
                  <Icon name="pin" class="size-4.5 flex-none text-brand" />
                  {area.data.name}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Services
    title="Services Available in Every Area"
    description="The same residential and commercial HVAC services wherever you are in our service area."
  />
  <Process />
  <Faq faqs={faqs} />
  <Contact />
  <CtaBanner />
</Layout>
