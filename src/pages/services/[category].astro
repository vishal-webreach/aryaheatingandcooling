---
import { Image } from 'astro:assets';
import Contact from '../../components/sections/Contact.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import Faq from '../../components/sections/Faq.astro';
import PageHero from '../../components/sections/PageHero.astro';
import Process from '../../components/sections/Process.astro';
import Reviews from '../../components/sections/Reviews.astro';
import Button from '../../components/ui/Button.astro';
import Eyebrow from '../../components/ui/Eyebrow.astro';
import Icon from '../../components/ui/Icon.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site';
import { categoryPath, getFaqs, getServiceGroups, servicePath } from '../../lib/content';
import { breadcrumbSchema, faqSchema } from '../../lib/seo';

// One page per main service, at /services/<category slug>/.
export async function getStaticPaths() {
  const serviceGroups = await getServiceGroups();
  return serviceGroups.map(({ category, services }) => ({
    params: { category: category.data.slug },
    props: { category, services },
  }));
}

const { category, services } = Astro.props;
// Card images only show when every service in the category has one, so a row never mixes both.
const showImages = services.every((service) => service.data.image);

const trail = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: category.data.title, href: categoryPath(category) },
];

// Each main service has its own questions, stored under the category's id.
const faqs = await getFaqs(category.id);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  breadcrumbSchema(
    trail.map((item) => ({ name: item.name, url: new URL(item.href, Astro.site).href })),
    pageUrl
  ),
  faqSchema(faqs, pageUrl),
];
---

<Layout
  title={category.data.seoTitle}
  description={category.data.seoDescription}
  image={category.data.image}
  imageAlt={category.data.imageAlt}
  pageType="CollectionPage"
  noindex={category.data.placeholder}
  mainEntity={category.data.placeholder ? undefined : `${pageUrl}#catalog`}
  schema={schema}
>
  <PageHero title={category.data.title} description={category.data.summary} trail={trail} />

  <section class="py-17 md:py-24" id="overview">
    <div class="wrap grid items-center gap-10 md:grid-cols-2 md:gap-18">
      <div>
        <Eyebrow>Our Services</Eyebrow>
        <h2 class="mb-3.5">{category.data.heading}</h2>
        {category.data.intro.map((paragraph) => <p class="mb-3.5">{paragraph}</p>)}
        <div class="mt-7.5 flex flex-wrap gap-3">
          <Button href="#contact">Get Free Quote <Icon name="arrow" /></Button>
          <Button href={site.phone.href} variant="dark"><Icon name="phone" /> Call {site.phone.display}</Button>
        </div>
      </div>

      <div class="relative pr-7 pb-7">
        <div
          class="absolute right-0 bottom-0 h-[70%] w-[62%] rounded-3xl bg-linear-135 from-brand to-navy-light"
          aria-hidden="true"
        >
        </div>
        <Image
          src={category.data.image}
          alt={category.data.imageAlt}
          widths={[320, category.data.image.width]}
          sizes="(min-width: 901px) 520px, 100vw"
          loading="eager"
          class="relative aspect-[4/3.4] w-full rounded-3xl object-cover"
        />
      </div>
    </div>
  </section>

  <section class="bg-soft py-17 md:py-24" id="services">
    <div class="wrap">
      <SectionHeading eyebrow="What We Do" title={`${category.data.title} Services`} />
      <ul class="grid gap-5.5 md:grid-cols-3">
        {
          services.map((service) => (
            <li class="group relative flex flex-col overflow-hidden rounded-card border border-line bg-white transition duration-250 hover:-translate-y-1 hover:border-transparent hover:shadow-card">
              {showImages && service.data.image && (
                <div class="overflow-hidden">
                  <Image
                    src={service.data.image}
                    alt={service.data.imageAlt ?? service.data.title}
                    widths={[320, service.data.image.width]}
                    sizes="(min-width: 901px) 376px, 100vw"
                    class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-106"
                  />
                </div>
              )}
              <div class="flex flex-1 flex-col p-6">
                <h3 class="mb-2.5">{service.data.title}</h3>
                <p class="flex-1 text-[15px]">{service.data.summary}</p>
                {servicePath(category, service) && (
                  <a
                    href={servicePath(category, service)}
                    class="mt-3.5 inline-flex items-center gap-2 text-[15px] font-bold text-ink transition-colors duration-200 after:absolute after:inset-0 hover:text-brand"
                  >
                    Learn more<span class="sr-only"> about {service.data.title}</span>
                    <Icon name="arrow" class="size-4.5 transition-transform duration-200 group-hover:translate-x-1" />
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Process />
  <Reviews />
  <Faq faqs={faqs} />
  <Contact />
  <CtaBanner />
</Layout>
