---
import { socialLinks } from '../../data/site';
import Icon from './Icon.astro';

type Variant = 'nav' | 'footer';

interface Props {
  variant: Variant;
  class?: string;
}

const { variant, class: className } = Astro.props;

const linkStyles: Record<Variant, string> = {
  nav: 'size-8.5 bg-soft text-navy hover:bg-accent hover:text-white',
  footer: 'size-10 border border-line bg-white text-navy hover:border-navy hover:bg-navy hover:text-white',
};

const iconSize = variant === 'footer' ? 'size-4.5' : 'size-4';
---

<div class:list={['flex items-center gap-2.5', className]}>
  {
    socialLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener"
        aria-label={link.label}
        class:list={['grid place-items-center rounded-card transition-colors duration-200', linkStyles[variant]]}
      >
        <Icon name={link.icon} class={iconSize} />
      </a>
    ))
  }
</div>
