---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Use on dark section backgrounds. */
  dark?: boolean;
  /** Centers the heading; any slotted button is placed below it. */
  center?: boolean;
}

const { eyebrow, title, description, dark = false, center = false } = Astro.props;
---

<div
  class:list={[
    'mb-9 flex flex-col gap-5 md:mb-12',
    center ? 'items-center text-center' : 'items-start md:flex-row md:items-end md:justify-between md:gap-10',
  ]}
>
  <div class="max-w-155">
    <Eyebrow tone={dark ? 'light' : 'navy'}>{eyebrow}</Eyebrow>
    <h2 class:list={[dark && 'text-white']}>{title}</h2>
    {description && <p class:list={['mt-3.5', dark && 'text-[#b9c8da]']}>{description}</p>}
  </div>
  <slot />
</div>
