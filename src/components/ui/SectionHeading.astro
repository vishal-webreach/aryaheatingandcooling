---
import Eyebrow from './Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  /** Use on dark section backgrounds. */
  dark?: boolean;
}

const { eyebrow, title, description, dark = false } = Astro.props;
---

<div class="mb-8 flex flex-col items-start gap-4.5 md:mb-11 md:flex-row md:items-end md:justify-between md:gap-8">
  <div class="max-w-155">
    <Eyebrow>{eyebrow}</Eyebrow>
    <h2 class:list={[dark && 'text-white']}>{title}</h2>
    {description && <p class="mt-3">{description}</p>}
  </div>
  <slot />
</div>
