---
import { site } from '../../data/site';
import { getServiceGroups } from '../../lib/content';
import Button from './Button.astro';
import ConsentCheckbox from './ConsentCheckbox.astro';
import FormField from './FormField.astro';
import Icon from './Icon.astro';

interface Props {
  /** Keeps field ids unique when the form is on the page more than once. */
  idPrefix: string;
  /** Column classes for the field grid, e.g. "sm:grid-cols-2 md:grid-cols-4". */
  columns: string;
  class?: string;
}

const { idPrefix, columns, class: className } = Astro.props;

const groups = await getServiceGroups();

// Service title -> its service types, read by the script to fill the second select.
const serviceTypes = Object.fromEntries(
  groups.map(({ category, services }) => [category.data.title, services.map((service) => service.data.title)])
);
---

<form
  action={site.formAction}
  method="post"
  data-quote-form
  data-service-types={JSON.stringify(serviceTypes)}
  class={className}
>
  <slot />
  <div class:list={['grid items-end gap-3', columns]}>
    <FormField id={`${idPrefix}-name`} name="name" label="Full Name" autocomplete="name" required />
    <FormField id={`${idPrefix}-email`} name="email" label="Email ID" type="email" autocomplete="email" required />
    <FormField id={`${idPrefix}-phone`} name="phone" label="Phone No" type="tel" autocomplete="tel" required />
    <FormField id={`${idPrefix}-address`} name="address" label="Full Address" autocomplete="street-address" required />
    <FormField
      id={`${idPrefix}-service`}
      name="service"
      label="Service Needed"
      as="select"
      placeholder="Select a service"
      options={groups.map(({ category }) => category.data.title)}
      required
    />
    <FormField
      id={`${idPrefix}-service-type`}
      name="serviceType"
      label="Service Type"
      as="select"
      placeholder="Select a service first"
      required
      disabled
    />
    <FormField id={`${idPrefix}-datetime`} name="datetime" label="Date & Time" type="datetime-local" required />
    <FormField id={`${idPrefix}-message`} name="message" label="Additional Info" />
  </div>
  <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
    <ConsentCheckbox class="flex-1 basis-80" />
    <Button type="submit" size="field" class="max-sm:w-full">Get Free Quote <Icon name="arrow" /></Button>
  </div>
</form>

<script>
  import '../../scripts/quote-form.ts';
</script>
