---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'ghost' | 'dark' | 'white' | 'outline';
type Size = 'md' | 'sm' | 'field' | 'bar';

interface Props {
  variant?: Variant;
  size?: Size;
  /** Renders a link when set, otherwise a button. */
  href?: string;
  /** Opens the link in a new tab. */
  external?: boolean;
  /** Opens the quote dialog. */
  quote?: boolean;
  type?: HTMLAttributes<'button'>['type'];
  class?: string;
}

const { variant = 'primary', size = 'md', href, external = false, quote = false, type = 'button', class: className } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'border-transparent bg-accent text-white shadow-cta hover:bg-accent-dark',
  // White outline for dark backgrounds
  ghost: 'border-white/50 text-white hover:border-white hover:bg-white hover:text-navy',
  dark: 'border-transparent bg-navy text-white hover:bg-navy-deep',
  white: 'border-transparent bg-white text-accent-dark hover:bg-soft',
  // Navy outline for light backgrounds
  outline: 'border-navy text-navy hover:bg-navy hover:text-white',
};

const sizes: Record<Size, string> = {
  md: 'px-6.5 py-3.75 text-[18px]',
  sm: 'px-4.5 py-3 text-[16px]',
  field: 'h-12.5 px-6.5 text-[18px] whitespace-nowrap',
  bar: 'px-2.5 py-3.25 text-[16px]',
};

const classes = [
  'inline-flex cursor-pointer items-center justify-center gap-2.5 rounded-card border-2 font-display leading-none font-bold tracking-[0.06em] uppercase transition duration-200 hover:-translate-y-0.5',
  variants[variant],
  sizes[size],
  className,
];
---

{
  href ? (
    <a
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener' : undefined}
      class:list={classes}
    >
      <slot />
    </a>
  ) : (
    <button type={type} data-quote-open={quote} class:list={classes}>
      <slot />
    </button>
  )
}
