---
import { site } from '../../data/site';
import { areaPath, getOrdered } from '../../lib/content';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';

const areas = await getOrdered('areas');

const itemClass =
  'flex items-center gap-2.5 rounded-card border border-line px-3.5 py-3 font-semibold text-ink';
---

<section class="py-18 md:py-24" id="areas">
  <div class="wrap grid items-start gap-9 lg:grid-cols-[0.8fr_1.2fr] lg:gap-14">
    <div>
      <Eyebrow>Where We Work</Eyebrow>
      <h2 class="mb-4">Service Areas</h2>
      <p class="mb-6.5">We serve Ashburn and the surrounding Northern Virginia communities.</p>
      <Button href={site.phone.href}><Icon name="phone" /> Call {site.phone.display}</Button>
    </div>

    <ul class="grid grid-cols-2 gap-2.5 sm:grid-cols-3">
      {
        areas.map((area) => (
          <li>
            {areaPath(area) ? (
              <a
                href={areaPath(area)}
                class:list={[itemClass, 'transition-colors duration-200 hover:border-accent hover:bg-[#fff7f5] hover:text-accent']}
              >
                <Icon name="pin" class="size-4.5 text-brand" />
                {area.data.name}
              </a>
            ) : (
              <span class={itemClass}>
                <Icon name="pin" class="size-4.5 text-brand" />
                {area.data.name}
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</section>
