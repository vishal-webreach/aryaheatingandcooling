---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<section class="relative overflow-hidden bg-heat text-white">
  <!-- Blue panel on the right, cut at an angle -->
  <div
    class="absolute inset-y-0 right-0 w-[38%] bg-cool [clip-path:polygon(18%_0,100%_0,100%_100%,0_100%)] max-md:hidden"
    aria-hidden="true"
  >
  </div>
  <div class="wrap relative flex flex-wrap items-center justify-between gap-6 py-13.5">
    <div>
      <h2 class="text-[clamp(30px,3.6vw,44px)] text-white">Need Heating or Cooling Help Right Now?</h2>
      <p class="mt-1.5 text-white/92">We are available 24/7 for emergency HVAC service.</p>
    </div>
    <Button href={site.phone.href} variant="white" class="max-sm:w-full">
      <Icon name="phone" /> Call {site.phone.display}
    </Button>
  </div>
</section>
