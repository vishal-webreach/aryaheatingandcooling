---
interface Props {
  title: string;
  description?: string;
  /** Breadcrumb trail from the home page; the last item is the current page. */
  trail: { name: string; href: string }[];
}

const { title, description, trail } = Astro.props;
---

<section class="bg-hero relative overflow-hidden py-14 text-white md:py-20">
  <div class="bg-hero-grid absolute inset-0" aria-hidden="true"></div>

  <div class="wrap relative">
    <nav aria-label="Breadcrumb" class="mb-5 text-[13.5px] font-semibold text-[#c3d1df]">
      <ol class="flex flex-wrap items-center gap-2">
        {
          trail.map((item, index) =>
            index < trail.length - 1 ? (
              <li class="flex items-center gap-2 after:text-white/40 after:content-['/']">
                <a href={item.href} class="transition-colors duration-200 hover:text-white">
                  {item.name}
                </a>
              </li>
            ) : (
              <li aria-current="page" class="text-white">
                {item.name}
              </li>
            )
          )
        }
      </ol>
    </nav>
    <h1 class="text-[clamp(32px,4.4vw,52px)] leading-[1.08] text-white">{title}</h1>
    {description && <p class="mt-4.5 max-w-155 text-[18px] text-[#c3d1df]">{description}</p>}
  </div>
</section>
