---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/images/hero/hero.png';

interface Props {
  title: string;
  description?: string;
  /** Breadcrumb trail from the home page; the last item is the current page. */
  trail: { name: string; href: string }[];
}

const { title, description, trail } = Astro.props;
---

<section class="relative overflow-hidden bg-navy-deep py-14 md:py-20">
  <!-- Same photo as the home hero, behind a dark navy shade -->
  <Picture
    src={heroImage}
    alt=""
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    widths={[768, 1080, 1440, heroImage.width]}
    sizes="100vw"
    priority
    class="absolute inset-0 size-full object-cover object-[70%_center]"
  />
  <div
    class="absolute inset-0 bg-linear-to-r from-navy-deep/95 via-navy-deep/85 to-navy-deep/55 max-md:bg-none max-md:bg-navy-deep/85"
    aria-hidden="true"
  >
  </div>

  <div class="wrap relative">
    <nav aria-label="Breadcrumb" class="mb-5 text-[14.5px] font-semibold text-[#d5e0ec]">
      <ol class="flex flex-wrap items-center gap-2">
        {
          trail.map((item, index) =>
            index < trail.length - 1 ? (
              <li class="flex items-center gap-2 after:text-white/40 after:content-['/']">
                <a href={item.href} class="transition-colors duration-200 hover:text-white">
                  {item.name}
                </a>
              </li>
            ) : (
              <li aria-current="page" class="text-glow">
                {item.name}
              </li>
            )
          )
        }
      </ol>
    </nav>
    <h1 class="text-[clamp(40px,5.4vw,68px)] leading-[0.98] text-white">{title}</h1>
    {description && <p class="mt-4.5 max-w-155 text-[19px] text-[#d5e0ec]">{description}</p>}
  </div>
</section>
