---
import { Picture } from 'astro:assets';
import heroImage from '../../assets/images/hero/hero.png';
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const trustPoints = ['Master Licensed Technicians', 'All Major Brands', 'Free Estimates'];

// Full-width background photos. With more than one, they fade into each other and dots appear.
// Photos here fill the whole screen, so they need to be at least 1600px wide.
const slides = [{ image: heroImage, alt: 'Pioneer Heating & Cooling technician servicing an HVAC system' }];

const photoWidths = (width: number) => [...[768, 1080, 1440].filter((w) => w < width), width];

const floatClass =
  'flex items-center gap-3 rounded-card bg-white px-4 py-3 text-[13.5px] leading-[1.3] text-ink shadow-card sm:px-4.5 sm:py-3.5 sm:text-[14px]';
const floatTitleClass = 'block font-display text-[20px] font-extrabold tracking-[0.02em] uppercase sm:text-[22px]';
const floatIconClass = 'grid size-10.5 flex-none place-items-center rounded-card text-white sm:size-11';
---

<section
  data-hero-slider
  aria-roledescription={slides.length > 1 ? 'carousel' : undefined}
  aria-label={slides.length > 1 ? 'Our work' : undefined}
  class="relative overflow-hidden bg-navy-deep"
>
  {
    slides.map((slide, index) => (
      <div
        data-hero-slide
        data-active={index === 0 || undefined}
        class="group/slide absolute inset-0 opacity-0 transition-opacity duration-1000 data-active:opacity-100"
      >
        <Picture
          src={slide.image}
          alt={slide.alt}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={photoWidths(slide.image.width)}
          sizes="100vw"
          priority={index === 0}
          class="size-full scale-108 object-cover object-[70%_center] transition-transform duration-[5.5s] ease-out group-data-active/slide:scale-100 motion-reduce:scale-100"
        />
      </div>
    ))
  }

  <!-- Dark navy shade, strongest behind the text on the left, so the heading stays readable on any photo -->
  <div
    class="absolute inset-0 bg-linear-to-r from-navy-deep/95 via-navy-deep/75 to-navy-deep/30 max-md:bg-none max-md:bg-navy-deep/80"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-x-0 bottom-0 h-2/5 bg-linear-to-t from-navy-deep/70 to-transparent" aria-hidden="true">
  </div>

  <div class="wrap relative pt-14 pb-30 md:pt-24 md:pb-40 lg:min-h-160">
    <div class="max-w-175">
      <span
        class="mb-5.5 inline-flex items-center gap-2.5 rounded-card border border-white/20 bg-white/10 py-2 pr-3.5 pl-2 text-[14.5px] font-semibold text-white backdrop-blur-sm"
      >
        <b class="rounded bg-accent px-2.25 py-1 font-display text-[15px] leading-none tracking-[0.06em] text-white">24/7</b>
        Emergency HVAC in Northern Virginia
      </span>
      <h1 class="text-[clamp(40px,5.6vw,76px)] leading-[0.96] text-white">
        Master Licensed HVAC Experts for Reliable, <span class="text-[#ff6a3d]">Year-Round</span>
        <span class="text-glow">Comfort</span>
      </h1>
      <p class="mt-5.5 max-w-135 text-[19px] text-[#d5e0ec]">
        Heating and cooling services you can rely on in Ashburn and across Northern Virginia. Available 24 hours a day, 7
        days a week.
      </p>
      <div class="mt-8 flex flex-wrap gap-3.5">
        <Button quote class="max-sm:w-full">Get Free Quote <Icon name="arrow" /></Button>
        <Button href={site.phone.href} variant="ghost" class="max-sm:w-full">
          <Icon name="phone" /> Call {site.phone.display}
        </Button>
      </div>
      <ul class="mt-7.5 flex flex-wrap gap-x-6.5 gap-y-3 text-[15.5px] font-semibold text-white">
        {
          trustPoints.map((point) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-4.5 text-glow" />
              {point}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Highlight cards: under the text on smaller screens, stacked on the right on wide screens -->
    <div class="mt-9 flex flex-wrap gap-3.5 lg:absolute lg:right-7 lg:bottom-40 lg:mt-0 lg:flex-col">
      <div class={floatClass}>
        <span class:list={[floatIconClass, 'bg-cool']}><Icon name="shield" /></span>
        <span><strong class={floatTitleClass}>Master Licensed</strong>HVAC technicians</span>
      </div>
      <div class={floatClass}>
        <span class:list={[floatIconClass, 'bg-heat']}><Icon name="clock" /></span>
        <span><strong class={floatTitleClass}>Open 24/7</strong>Emergency service</span>
      </div>
    </div>

    {
      slides.length > 1 && (
        <div class="absolute right-5 bottom-24 flex gap-2 sm:right-7 md:bottom-28">
          {slides.map((_, index) => (
            <button
              type="button"
              data-hero-dot
              aria-label={`Show photo ${index + 1} of ${slides.length}`}
              aria-current={index === 0 ? 'true' : 'false'}
              class="h-3 w-3 cursor-pointer rounded-full border-2 border-white transition-[width,background-color] duration-300 aria-[current=true]:w-8 aria-[current=true]:bg-white"
            />
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  import '../../scripts/hero-slider.ts';
</script>
