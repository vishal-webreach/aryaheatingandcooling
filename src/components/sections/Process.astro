---
import SectionHeading from '../ui/SectionHeading.astro';

const steps = [
  {
    title: 'Contact Us',
    text: 'Complete the free quote form or call us to share your heating and cooling needs.',
  },
  {
    title: 'Schedule Your Estimate',
    text: "We'll arrange a property visit at a time that works for you and give an in-person estimate.",
  },
  {
    title: 'Get The Job Done',
    text: 'After you approve the estimate, we schedule a date and complete the job.',
  },
];

// Step circle colors, in turn: red, navy, blue
const stepColors = ['border-accent text-accent', 'border-navy text-navy', 'border-brand text-brand'];
---

<section class="py-18 md:py-24" id="process">
  <div class="wrap">
    <SectionHeading eyebrow="How It Works" title="Our Simple 3 Step Process" center />

    <div class="relative grid gap-10 md:grid-cols-3">
      <!-- Line joining the step circles -->
      <div class="absolute inset-x-[12%] top-11 h-0.75 bg-heat-cool opacity-50 max-md:hidden" aria-hidden="true"></div>
      {
        steps.map((step, index) => (
          <div class="relative text-center">
            <div
              class:list={[
                'mx-auto mb-6 grid size-22 place-items-center rounded-full border-3 bg-white font-display text-[36px] font-extrabold',
                stepColors[index % stepColors.length],
              ]}
            >
              {String(index + 1).padStart(2, '0')}
            </div>
            <h3 class="mb-2.5">{step.title}</h3>
            <p class="mx-auto max-w-80">{step.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
