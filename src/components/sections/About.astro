---
import { Image } from 'astro:assets';
import aboutImage from '../../assets/images/about/about.png';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';

const highlights = [
  'Master Licensed Technicians',
  'We work on all major brands and every type of unit',
  'Available 24 hours a day, 7 days a week',
  'Free estimates with no obligation',
];
---

<section class="bg-soft py-18 md:py-24" id="about">
  <div class="wrap grid items-center gap-14 md:grid-cols-2 md:gap-18">
    <div class="relative isolate ml-4.5 md:ml-0">
      <!-- Blue outline frame offset behind the photo -->
      <div
        class="absolute -top-4.5 right-4.5 bottom-4.5 -left-4.5 -z-1 rounded-card border-3 border-glow"
        aria-hidden="true"
      >
      </div>
      <Image
        src={aboutImage}
        alt="Pioneer Heating & Cooling technician installing an air conditioning unit"
        widths={[320, aboutImage.width]}
        sizes="(min-width: 901px) 580px, 100vw"
        class="aspect-[5/5.2] w-full rounded-card object-cover"
      />
      <div
        class="absolute right-3 bottom-8.5 rounded-card bg-heat px-6 py-5 leading-[1.15] font-semibold text-white shadow-card md:-right-5.5"
      >
        <strong class="block font-display text-[56px] leading-[0.9] font-extrabold">10+</strong>years in<br />business
      </div>
    </div>

    <div>
      <Eyebrow>Who We Are</Eyebrow>
      <h2 class="mb-4.5">About Pioneer Heating &amp; Cooling</h2>
      <p>
        With over 10 years in business, Pioneer Heating &amp; Cooling is built on experience, trust, and hands-on service.
        Our Master Licensed Technicians focus on quality work and reliable emergency HVAC to keep your home comfortable
        year-round.
      </p>
      <ul class="mt-6.5 mb-8 grid gap-3">
        {
          highlights.map((highlight) => (
            <li class="flex items-start gap-3 font-semibold text-ink">
              <span class="mt-px grid size-6.5 flex-none place-items-center rounded-full bg-navy text-white">
                <Icon name="check" class="size-3.5 stroke-3" />
              </span>
              {highlight}
            </li>
          ))
        }
      </ul>
      <div class="flex flex-wrap gap-3.5">
        <Button quote>Get Free Quote <Icon name="arrow" /></Button>
        <Button href="/about/" variant="outline">More About Us</Button>
      </div>
    </div>
  </div>
</section>
