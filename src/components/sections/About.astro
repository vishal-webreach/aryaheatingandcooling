---
import { Image } from 'astro:assets';
import aboutImage from '../../assets/images/about/about.png';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';

const highlights = [
  'Master Licensed Technicians',
  'We work on all major brands and every type of unit',
  'Available 24 hours a day, 7 days a week',
  'Free estimates with no obligation',
];
---

<section class="bg-soft py-17 md:py-24" id="about">
  <div class="wrap grid items-center gap-10 md:grid-cols-2 md:gap-18">
    <div class="relative pb-7 pl-7">
      <div
        class="absolute bottom-0 left-0 h-[70%] w-[62%] rounded-3xl bg-linear-135 from-brand to-navy-light"
        aria-hidden="true"
      >
      </div>
      <Image
        src={aboutImage}
        alt="ARYA Heating & Cooling technician installing an air conditioning unit"
        widths={[320, aboutImage.width]}
        sizes="(min-width: 901px) 520px, 100vw"
        class="relative aspect-[4/3.4] w-full rounded-3xl object-cover"
      />
      <div
        class="absolute top-7 right-2.5 rounded-[18px] bg-accent px-5 py-4 text-[13px] leading-[1.3] font-bold text-white shadow-card md:-right-4.5"
      >
        <strong class="block text-[32px] leading-none font-extrabold">10+</strong>years in<br />business
      </div>
    </div>

    <div>
      <Eyebrow>Who We Are</Eyebrow>
      <h2 class="mb-3.5">About ARYA Heating &amp; Cooling</h2>
      <p>
        With over 10 years in business, ARYA Heating &amp; Cooling is built on experience, trust, and hands-on service.
        Our Master Licensed Technicians focus on quality work and reliable emergency HVAC to keep your home comfortable
        year-round.
      </p>
      <ul class="mt-6.5 mb-7.5 grid gap-3 sm:grid-cols-2">
        {
          highlights.map((highlight) => (
            <li class="flex items-start gap-3 rounded-[14px] border border-line bg-white px-4 py-3.5 text-[14.5px] leading-[1.45] font-semibold text-ink">
              <Icon name="check" class="size-5.5 rounded-full bg-brand stroke-3 p-1 text-white" />
              {highlight}
            </li>
          ))
        }
      </ul>
      <div class="flex flex-wrap gap-3">
        <Button quote>Get Free Quote <Icon name="arrow" /></Button>
        <Button href="/about/" variant="dark">More About Us</Button>
      </div>
    </div>
  </div>
</section>
