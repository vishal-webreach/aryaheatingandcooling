---
const stats = [
  { value: '10+', label: 'Years of Experience' },
  { value: '10,000+', label: 'Jobs Completed' },
  { value: '24/7', label: 'Emergency Service' },
  { value: 'Free', label: 'Estimates' },
];
---

<section class="border-b border-line" aria-label="Company highlights">
  <div class="wrap">
    <ul class="grid grid-cols-2 md:grid-cols-4">
      {
        stats.map((stat, index) => (
          <li class="border-line px-2.5 py-7 text-center max-md:even:border-l max-md:nth-[n+3]:border-t sm:px-6 sm:py-10 md:not-first:border-l">
            <strong
              class:list={[
                'block font-display text-[38px] leading-none font-extrabold sm:text-[clamp(44px,5vw,62px)]',
                index % 2 === 0 ? 'text-accent' : 'text-navy',
              ]}
            >
              {stat.value}
            </strong>
            <span class="mt-2 block text-[12.5px] font-semibold tracking-[0.06em] uppercase sm:text-[14px]">
              {stat.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
