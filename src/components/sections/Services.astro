---
import { Image } from 'astro:assets';
import { categoryPath, getServiceGroups, servicePath } from '../../lib/content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Our Heating and Cooling Services',
  description = 'Residential and commercial HVAC service, plus contracts that keep every system maintained.',
} = Astro.props;

const serviceGroups = await getServiceGroups();

// Number tag colors, in turn: red, navy, blue
const numberColors = ['bg-accent', 'bg-navy', 'bg-brand'];
---

<section class="py-18 md:py-24" id="services">
  <div class="wrap">
    <SectionHeading
      eyebrow="What We Do"
      title={title}
      description={description}
    >
      <Button href="/services/" variant="dark">View Services</Button>
    </SectionHeading>

    <div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        serviceGroups.map(({ category, services }, index) => (
          <div class="group relative flex flex-col overflow-hidden rounded-card border border-line bg-white transition duration-250 hover:-translate-y-1.5 hover:shadow-card">
            <div class="relative overflow-hidden">
              <Image
                src={category.data.image}
                alt={category.data.imageAlt}
                widths={[320, category.data.image.width]}
                sizes="(min-width: 1081px) 395px, (min-width: 561px) 50vw, 100vw"
                class="aspect-16/10 w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
              <span
                class:list={[
                  'absolute bottom-0 left-0 px-4.5 py-2.5 font-display text-[22px] leading-none font-extrabold tracking-[0.04em] text-white',
                  numberColors[index % numberColors.length],
                ]}
              >
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-7">
              <h3 class="font-display text-[30px] leading-none font-extrabold uppercase">{category.data.title}</h3>
              <p class="mt-2.5">{category.data.summary}</p>
              <ul class="mt-5 mb-6 border-t border-line">
                {services.map((service) =>
                  servicePath(category, service) ? (
                    <li>
                      <a
                        href={servicePath(category, service)}
                        class="relative z-1 flex items-center justify-between gap-3 border-b border-line py-3 font-semibold text-ink transition-colors duration-200 hover:text-accent"
                      >
                        {service.data.title}
                        <Icon name="arrow" class="size-4.5 text-brand" />
                      </a>
                    </li>
                  ) : (
                    <li class="flex items-center gap-3 border-b border-line py-3 font-semibold text-ink">
                      {service.data.title}
                    </li>
                  )
                )}
              </ul>
              <a
                href={categoryPath(category)}
                class="mt-auto inline-flex items-center gap-2 font-display text-[18px] font-bold tracking-[0.06em] text-accent uppercase after:absolute after:inset-0"
              >
                Learn more<span class="sr-only"> about {category.data.title}</span>
                <Icon name="arrow" class="size-5 transition-transform duration-200 group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
