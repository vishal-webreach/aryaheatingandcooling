---
import { Image } from 'astro:assets';
import { categoryPath, getServiceGroups, servicePath } from '../../lib/content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const serviceGroups = await getServiceGroups();
---

<section class="py-17 md:py-24" id="services">
  <div class="wrap">
    <SectionHeading
      eyebrow="What We Do"
      title="Our Heating and Cooling Services"
      description="Residential and commercial HVAC service, plus contracts that keep every system maintained."
    >
      <Button href="/services/" variant="dark">View Services</Button>
    </SectionHeading>

    <div class="grid gap-5.5 sm:grid-cols-2 lg:grid-cols-3">
      {
        serviceGroups.map(({ category, services }, index) => (
          <div class="group relative flex flex-col overflow-hidden rounded-card border border-line bg-white transition duration-250 hover:-translate-y-1.5 hover:border-transparent hover:shadow-card">
            <div class="relative overflow-hidden">
              <Image
                src={category.data.image}
                alt={category.data.imageAlt}
                widths={[320, category.data.image.width]}
                sizes="(min-width: 1081px) 376px, (min-width: 561px) 50vw, 100vw"
                class="aspect-4/3 w-full object-cover transition-transform duration-500 group-hover:scale-106"
              />
              <span class="absolute top-4 left-4 rounded-full bg-white px-3 py-1 text-[13px] font-extrabold text-ink">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <div class="flex flex-1 flex-col p-6">
              <h3 class="mb-3.5">{category.data.title}</h3>
              <p class="mb-3.5 text-[15px]">{category.data.summary}</p>
              <ul class="mb-4.5 flex-1">
                {services.map((service) => (
                  <li class="mb-1.5 flex items-center gap-2 text-[15px] font-semibold">
                    <Icon name="check" class="size-4 flex-none text-brand" />
                    {servicePath(category, service) ? (
                      <a
                        href={servicePath(category, service)}
                        class="relative z-1 text-ink transition-colors duration-200 hover:text-brand"
                      >
                        {service.data.title}
                      </a>
                    ) : (
                      <span class="text-ink">{service.data.title}</span>
                    )}
                  </li>
                ))}
              </ul>
              <a
                href={categoryPath(category)}
                class="inline-flex items-center gap-2 text-[15px] font-bold text-ink transition-colors duration-200 after:absolute after:inset-0 hover:text-brand"
              >
                Learn more<span class="sr-only"> about {category.data.title}</span>
                <Icon name="arrow" class="size-4.5 transition-transform duration-200 group-hover:translate-x-1" />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
