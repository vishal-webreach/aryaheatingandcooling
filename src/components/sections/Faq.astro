---
import { site } from '../../data/site';
import type { CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  /** The page's questions; pass the same list to `faqSchema`. */
  faqs: CollectionEntry<'faqs'>[];
}

const { faqs } = Astro.props;
---

<section class="bg-soft py-18 md:py-24" id="faq">
  <div class="wrap grid items-start gap-9 md:grid-cols-[0.8fr_1.2fr] md:gap-14">
    <div>
      <Eyebrow>FAQ</Eyebrow>
      <h2>Frequently Asked Questions</h2>
      <div class="mt-7 rounded-card border border-line border-l-4 border-l-accent bg-white p-6">
        <strong class="block text-[18px] text-ink">Still have a question?</strong>
        <p class="mb-4 text-[16px]">Call us any time, day or night.</p>
        <Button href={site.phone.href} variant="dark"><Icon name="phone" /> {site.phone.display}</Button>
      </div>
    </div>

    <div class="grid gap-3">
      {
        faqs.map((faq, index) => (
          <details class="group rounded-card border border-line bg-white" open={index === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5.5 py-5 text-[18px] font-bold text-ink [&::-webkit-details-marker]:hidden">
              {faq.data.question}
              <!-- Plus drawn with two bars; the upright one turns flat to make a minus when open -->
              <span
                class="relative size-7.5 flex-none rounded-full bg-soft transition-colors duration-200 group-open:bg-accent"
                aria-hidden="true"
              >
                <span class="absolute top-1/2 left-1/2 h-0.5 w-3 -translate-1/2 bg-navy group-open:bg-white"></span>
                <span class="absolute top-1/2 left-1/2 h-0.5 w-3 -translate-1/2 rotate-90 bg-navy transition-transform duration-250 group-open:rotate-0 group-open:bg-white"></span>
              </span>
            </summary>
            <p class="px-5.5 pb-5.5">{faq.data.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
