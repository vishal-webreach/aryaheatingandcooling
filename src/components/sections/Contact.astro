---
import { site, type IconName } from '../../data/site';
import Button from '../ui/Button.astro';
import ConsentCheckbox from '../ui/ConsentCheckbox.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';

interface ContactItem {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
}

const contactItems: ContactItem[] = [
  { icon: 'phone', label: 'Phone', value: site.phone.display, href: site.phone.href },
  { icon: 'mail', label: 'Email', value: site.email.display, href: site.email.href },
  { icon: 'clock', label: 'Hours', value: 'Open 24 hours, 7 days a week' },
  { icon: 'pin', label: 'Area', value: 'Ashburn, VA & Northern Virginia' },
];
---

<section class="py-18 md:py-24" id="contact">
  <div class="wrap">
    <div class="grid overflow-hidden rounded-card shadow-card md:grid-cols-[0.9fr_1.1fr]">
      <div class="relative overflow-hidden bg-navy px-5.5 py-9 text-[#c4d3e4] sm:px-11 sm:py-12">
        <div
          class="pointer-events-none absolute -right-30 -bottom-35 size-85 rotate-30 rounded-full border-44 border-transparent border-t-[rgb(224_74_28/0.25)] border-l-[rgb(54_169_225/0.25)]"
          aria-hidden="true"
        >
        </div>
        <Eyebrow tone="light">Contact Us</Eyebrow>
        <h2 class="mb-3.5 text-white">Send Us A Message</h2>
        <p>
          Have a question or need a call back? Send us a message and we will get back to you. For urgent problems, call
          us any time.
        </p>
        <ul class="relative mt-8 grid gap-4.5">
          {
            contactItems.map((item) => (
              <li class="flex items-center gap-3.5 text-[17px] leading-[1.4] font-bold wrap-anywhere text-white">
                <Icon name={item.icon} class="size-11.5 rounded-card bg-white/8 p-3 text-white" />
                <span>
                  <small class="block text-[12.5px] font-semibold tracking-[0.08em] text-[#c4d3e4] uppercase">{item.label}</small>
                  {item.href ? (
                    <a href={item.href} class="transition-colors duration-200 hover:text-glow">
                      {item.value}
                    </a>
                  ) : (
                    item.value
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <form action={site.formAction} method="post" class="bg-white px-5.5 py-9 text-body sm:px-11 sm:py-12">
        <h3 class="mb-5 font-display text-[32px] font-extrabold uppercase">How can we help?</h3>
        <FormField id="name" name="name" label="Full Name" autocomplete="name" required class="mb-4" />
        <div class="mb-4 grid gap-4 sm:grid-cols-2">
          <FormField id="email" name="email" label="Email ID" type="email" autocomplete="email" required />
          <FormField id="phone" name="phone" label="Phone No" type="tel" autocomplete="tel" required />
        </div>
        <FormField id="message" name="message" label="Message" as="textarea" class="mb-4" />
        <ConsentCheckbox class="mb-5" />
        <Button type="submit" class="w-full">Send Message <Icon name="arrow" /></Button>
      </form>
    </div>
  </div>
</section>
