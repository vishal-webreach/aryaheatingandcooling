---
import { site, type IconName } from '../../data/site';
import Button from '../ui/Button.astro';
import ConsentCheckbox from '../ui/ConsentCheckbox.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';

interface ContactItem {
  icon: IconName;
  label: string;
  value: string;
  href?: string;
}

const contactItems: ContactItem[] = [
  { icon: 'phone', label: 'Phone', value: site.phone.display, href: site.phone.href },
  { icon: 'mail', label: 'Email', value: site.email.display, href: site.email.href },
  { icon: 'clock', label: 'Hours', value: 'Open 24 hours, 7 days a week' },
  { icon: 'pin', label: 'Area', value: 'Ashburn, VA & Northern Virginia' },
];
---

<section class="bg-soft py-17 md:py-24" id="contact">
  <div class="wrap">
    <div
      class="bg-contact grid items-center gap-10 rounded-[22px] px-6 py-8.5 text-[#b9c7d6] md:grid-cols-2 md:gap-14 md:rounded-[28px] md:p-14"
    >
      <div>
        <Eyebrow tone="glow">Contact Us</Eyebrow>
        <h2 class="mb-3.5 text-white">Send Us A Message</h2>
        <p>
          Have a question or need a call back? Send us a message and we will get back to you. For urgent problems, call
          us any time.
        </p>
        <ul class="mt-7 grid gap-3.5">
          {
            contactItems.map((item) => (
              <li class="flex items-center gap-3.5 text-[15px] leading-[1.4] font-semibold wrap-anywhere text-white">
                <Icon name={item.icon} class="size-11 rounded-xl bg-white/8 p-3 text-glow" />
                <span>
                  <small class="block text-xs font-bold tracking-widest text-[#8fa3b8] uppercase">{item.label}</small>
                  {item.href ? (
                    <a href={item.href} class="transition-colors duration-200 hover:text-glow">
                      {item.value}
                    </a>
                  ) : (
                    item.value
                  )}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <form action={site.formAction} method="post" class="rounded-[22px] bg-white px-5 py-6 text-body sm:p-8.5">
        <h3 class="mb-5 text-[22px]">How can we help?</h3>
        <FormField id="name" name="name" label="Full Name" autocomplete="name" required class="mb-4" />
        <div class="mb-4 grid gap-4 sm:grid-cols-2">
          <FormField id="email" name="email" label="Email ID" type="email" autocomplete="email" required />
          <FormField id="phone" name="phone" label="Phone No" type="tel" autocomplete="tel" required />
        </div>
        <FormField id="message" name="message" label="Message" as="textarea" class="mb-4" />
        <ConsentCheckbox class="mb-5" />
        <Button type="submit" class="w-full">Send Message <Icon name="arrow" /></Button>
      </form>
    </div>
  </div>
</section>
