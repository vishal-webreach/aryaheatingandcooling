---
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';

const barClass =
  'flex h-16 cursor-pointer items-center justify-center gap-2 font-display text-[18px] font-bold tracking-[0.06em] text-white uppercase';
---

<!-- Phones only: call and quote buttons fixed to the bottom of the screen -->
<div class="fixed inset-x-0 bottom-0 z-60 grid grid-cols-2 md:hidden">
  <a href={site.phone.href} class:list={[barClass, 'bg-navy']}><Icon name="phone" /> Call Now</a>
  <button type="button" data-quote-open class:list={[barClass, 'bg-accent']}>Free Quote</button>
</div>
