---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<div
  class="fixed inset-x-0 bottom-0 z-60 grid grid-cols-2 gap-2.5 border-t border-line bg-white px-3.5 py-2.5 shadow-[0_-10px_24px_-14px_rgb(11_31_51/0.3)] md:hidden"
>
  <Button href={site.phone.href} variant="dark" size="bar"><Icon name="phone" /> Call Now</Button>
  <Button quote size="bar">Free Quote</Button>
</div>
