---
import { Image } from 'astro:assets';
import logo from '../../assets/images/brand/logo.png';
import { site } from '../../data/site';
import { categoryPath, getOrdered } from '../../lib/content';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';

const services = await getOrdered('serviceCategories');

const quickLinks: { label: string; href: string; external?: boolean }[] = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Services', href: '/services/' },
  { label: 'Service Areas', href: '/service-areas/' },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Contact', href: '/contact-us/' },
  { label: 'Review Us', href: site.reviewHref, external: site.reviewHref !== '#' },
];

const year = new Date().getFullYear();

const headingClass = 'mb-4.5 font-display text-[20px] font-extrabold tracking-[0.08em] text-navy uppercase';
const linkClass = 'transition-colors duration-200 hover:text-accent';
const contactClass = 'mb-2.25 flex items-center gap-2.5 wrap-anywhere';
const bottomLinkClass = 'transition-colors duration-200 hover:text-white';
---

<footer class="bg-soft pt-18 text-[15.5px] text-body">
  <div class="wrap grid gap-10 sm:grid-cols-2 md:grid-cols-[1.4fr_1fr_1fr_1.3fr] md:gap-11">
    <div>
      <a href="/" class="mb-4.5 inline-block">
        <Image
          src={logo}
          alt="Pioneer Heating & Cooling"
          height={72}
          densities={[1, 2]}
          loading="lazy"
          class="h-18 w-auto"
        />
      </a>
      <p>Master Licensed HVAC experts serving Ashburn and Northern Virginia.</p>
      <SocialLinks variant="footer" class="mt-4.5" />
    </div>

    <div>
      <h3 class={headingClass}>Services</h3>
      <ul>
        {
          services.map((service) => (
            <li class="mb-2.25">
              <a href={categoryPath(service)} class={linkClass}>
                {service.data.title}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class={headingClass}>Quick Links</h3>
      <ul>
        {
          quickLinks.map((link) => (
            <li class="mb-2.25">
              <a
                href={link.href}
                target={link.external ? '_blank' : undefined}
                rel={link.external ? 'noopener' : undefined}
                class={linkClass}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class={headingClass}>Contact &amp; Hours</h3>
      <ul>
        <li class={contactClass}>
          <Icon name="phone" class="size-4.5 text-accent" />
          <a href={site.phone.href} class={linkClass}>{site.phone.display}</a>
        </li>
        <li class={contactClass}>
          <Icon name="mail" class="size-4.5 text-accent" />
          <a href={site.email.href} class={linkClass}>{site.email.display}</a>
        </li>
        <li class={contactClass}>
          <Icon name="clock" class="size-4.5 text-accent" />
          <span>Monday &ndash; Sunday &middot; Open 24 Hours</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="mt-14 bg-navy-deep py-5 text-sm text-[#9fb2c8]">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
      <span>&copy; {year} {site.name}. All rights reserved.</span>
      <span>
        {site.privacyHref ? <a href={site.privacyHref} class={bottomLinkClass}>Privacy Policy</a> : 'Privacy Policy'}
        <span class="mx-1.5">|</span>
        {site.termsHref ? <a href={site.termsHref} class={bottomLinkClass}>Terms &amp; Conditions</a> : <Fragment>Terms &amp; Conditions</Fragment>}
      </span>
    </div>
  </div>
</footer>
