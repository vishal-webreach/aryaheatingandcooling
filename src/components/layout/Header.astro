---
import { Image } from 'astro:assets';
import logo from '../../assets/images/brand/logo.png';
import { site, type IconName } from '../../data/site';
import { areaPath, categoryPath, getOrdered, getServiceGroups, servicePath } from '../../lib/content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SocialLinks from '../ui/SocialLinks.astro';

interface NavLink {
  label: string;
  href: string;
  /** Sub-links shown in a dropdown. */
  children?: MaybeLink[];
  /** Sub-links shown in a dropdown, one headed column per group. */
  groups?: (SubLink & { children: MaybeLink[] })[];
  toggleLabel?: string;
  /** Lays the dropdown out in columns. */
  columns?: boolean;
}

interface SubLink {
  label: string;
  href: string;
}

/** A sub-link without an `href` has no page yet and is shown as plain text. */
type MaybeLink = Omit<SubLink, 'href'> & { href?: string };

const serviceGroups = await getServiceGroups();
const areas = await getOrdered('areas');

const navLinks: NavLink[] = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  {
    label: 'Services',
    href: '/services/',
    toggleLabel: 'Show services',
    groups: serviceGroups.map(({ category, services }) => ({
      label: category.data.title,
      href: categoryPath(category),
      children: services.map((service) => ({ label: service.data.title, href: servicePath(category, service) })),
    })),
  },
  {
    label: 'Service Areas',
    href: '/service-areas/',
    toggleLabel: 'Show service areas',
    columns: true,
    children: areas.map((area) => ({ label: area.data.name, href: areaPath(area) })),
  },
  { label: 'Gallery', href: '/gallery/' },
  { label: 'Contact', href: '/contact-us/' },
];

// Contact details in the white top row of the header
const infoItems: { icon: IconName; label: string; value: string; href?: string; iconClass: string; class?: string }[] = [
  { icon: 'phone', label: '24/7 Emergency', value: site.phone.display, href: site.phone.href, iconClass: 'bg-heat' },
  { icon: 'clock', label: 'Open Hours', value: 'Mon – Sun · 24 Hours', iconClass: 'bg-cool' },
  {
    icon: 'mail',
    label: 'Email Us',
    value: site.email.display,
    href: site.email.href,
    iconClass: 'bg-linear-135 from-navy to-navy-deep',
    class: 'max-lg:hidden',
  },
];

const { pathname } = Astro.url;
const isCurrent = (href?: string) => href === pathname;
/** True when the link, or any link in its dropdown, is the current page. */
const isActive = (link: NavLink) =>
  isCurrent(link.href) ||
  (link.children ?? []).some((child) => isCurrent(child.href)) ||
  (link.groups ?? []).some((group) => isCurrent(group.href) || group.children.some((child) => isCurrent(child.href)));
const current = (href?: string) => (isCurrent(href) ? 'page' : undefined);

// Phones: dark text in the white drawer. Desktop: light capitals on the navy bar with a red underline.
const linkClass =
  'relative rounded-card px-3.5 py-3 text-[15px] font-semibold text-ink transition-colors duration-200 hover:bg-soft hover:text-accent md:px-2.5 md:py-2.5 md:tracking-[0.06em] md:whitespace-nowrap md:text-[#d4e1ee] md:uppercase md:hover:bg-transparent md:hover:text-white md:after:absolute md:after:inset-x-2.5 md:after:bottom-1 md:after:h-0.5 md:after:origin-left md:after:scale-x-0 md:after:bg-accent md:after:transition-transform md:after:duration-250 md:hover:after:scale-x-100 lg:px-3.5 lg:after:inset-x-3.5';
const subLinkClass =
  'block rounded-card px-3 py-2.25 text-[14.5px] font-medium text-ink transition-colors duration-200 hover:bg-soft hover:text-accent aria-[current=page]:bg-soft aria-[current=page]:text-accent md:px-2.5 md:py-2 md:text-[15px] md:font-semibold md:whitespace-nowrap lg:px-3.5';
const subLabelClass =
  'block px-3 py-2.25 text-[14.5px] font-medium text-body md:px-2.5 md:py-2 md:text-[15px] md:font-semibold md:whitespace-nowrap lg:px-3.5';
const groupLinkClass =
  'block rounded-card px-3 py-2.25 font-display text-[16px] font-bold tracking-[0.06em] text-navy uppercase transition-colors duration-200 hover:bg-soft hover:text-accent aria-[current=page]:bg-soft aria-[current=page]:text-accent md:px-2.5 md:py-2 md:whitespace-nowrap lg:px-3.5';
const contactClass = 'group/contact flex items-center gap-2.5 p-1 text-[13px] font-semibold text-ink wrap-anywhere';
const contactIconClass =
  'grid size-7 flex-none place-items-center rounded-full bg-soft text-ink transition-colors duration-200 group-hover/contact:bg-accent group-hover/contact:text-white';
---

<!-- White top row: logo and contact details. On phones it stays at the top with the Menu button. -->
<header class="relative bg-white max-md:sticky max-md:top-0 max-md:z-70 max-md:border-b max-md:border-line">
  <div class="wrap flex h-19 items-center justify-between gap-6 md:h-24">
    <a href="/" class="flex-none">
      <Image
        src={logo}
        alt="Pioneer Heating & Cooling logo"
        height={60}
        densities={[1, 2]}
        loading="eager"
        class="h-12 w-auto md:h-15"
      />
    </a>

    <div class="flex items-center gap-7.5 max-md:hidden">
      {
        infoItems.map((item) => {
          const Tag = item.href ? 'a' : 'span';
          return (
            <Tag
              href={item.href}
              class:list={['flex items-center gap-3 leading-tight font-bold text-ink', item.class]}
            >
              <span class:list={['grid size-11 flex-none place-items-center rounded-full text-white', item.iconClass]}>
                <Icon name={item.icon} class="size-4.5" />
              </span>
              <span>
                <small class="block text-xs font-semibold tracking-[0.08em] text-body uppercase">{item.label}</small>
                {item.value}
              </span>
            </Tag>
          );
        })
      }
    </div>

    <button
      type="button"
      data-menu-btn
      aria-controls="nav"
      aria-expanded="false"
      class="inline-flex cursor-pointer items-center gap-2 rounded-card border-2 border-line bg-white px-3.5 py-2.5 text-[15px] font-bold text-ink transition-colors duration-200 aria-expanded:border-accent aria-expanded:text-accent md:hidden"
    >
      <Icon name="menu" />Menu
    </button>
  </div>
  <span class="absolute inset-x-0 -bottom-px h-0.75 bg-heat-cool md:hidden" aria-hidden="true"></span>
</header>

<!-- Navy menu bar. It sticks to the top on desktop; on phones only its drawer is used. -->
<div class="max-md:contents md:sticky md:top-0 md:z-50 md:bg-navy md:shadow-[0_10px_24px_-18px_rgb(0_0_0/0.6)]">
  <div class="wrap max-md:contents md:flex md:h-16 md:items-center md:justify-between md:gap-6">
    <div
      data-nav-overlay
      class="invisible fixed inset-0 z-75 bg-navy-deep/55 opacity-0 transition-[opacity,visibility] duration-300 data-open:visible data-open:opacity-100 md:hidden"
    >
    </div>

    <nav
      id="nav"
      data-nav
      aria-label="Main"
      class="flex max-md:invisible max-md:fixed max-md:inset-y-0 max-md:right-0 max-md:z-80 max-md:w-[min(86vw,340px)] max-md:translate-x-full max-md:flex-col max-md:gap-0.5 max-md:overflow-y-auto max-md:overscroll-contain max-md:bg-white max-md:px-4 max-md:pb-7 max-md:shadow-[-18px_0_40px_-18px_rgb(12_35_64/0.4)] max-md:transition-[translate,visibility] max-md:duration-300 max-md:data-open:visible max-md:data-open:translate-x-0 md:-ml-2.5 md:items-center lg:-ml-3.5"
    >
      <div
        class="sticky top-0 z-1 -mx-4 mb-2 flex items-center justify-between border-b border-line bg-white px-4 py-3.5 font-display text-[20px] font-extrabold text-ink uppercase md:hidden"
      >
        <span>Menu</span>
        <button
          type="button"
          data-nav-close
          aria-label="Close menu"
          class="grid size-10 cursor-pointer place-items-center rounded-full bg-soft text-ink"
        >
          <Icon name="close" />
        </button>
      </div>

      {
        navLinks.map((link) =>
          link.children || link.groups ? (
            <div
              data-nav-item
              data-active={isActive(link) || undefined}
              class="group/item relative flex items-center max-md:flex-wrap"
            >
              <a
                href={link.href}
                aria-current={current(link.href)}
                class:list={[
                  linkClass,
                  'max-md:flex-1 max-md:group-data-active/item:bg-soft max-md:group-data-active/item:text-accent md:pr-1.5 md:group-hover/item:text-white md:group-hover/item:after:scale-x-100 md:group-data-active/item:text-white md:group-data-active/item:after:scale-x-100 lg:pr-2',
                ]}
              >
                {link.label}
              </a>
              <button
                type="button"
                data-nav-toggle
                aria-expanded="false"
                aria-label={link.toggleLabel}
                class="grid cursor-pointer place-items-center text-ink max-md:size-11 max-md:rounded-card max-md:bg-soft md:mr-1 md:h-8.5 md:w-5 md:text-[#d4e1ee] md:group-hover/item:text-white md:group-data-active/item:text-white"
              >
                <Icon
                  name="chevron"
                  class="size-4.5 transition-transform duration-250 group-data-open/item:rotate-180 md:size-3.75 md:group-hover/item:rotate-180"
                />
              </button>

              <div
                class:list={[
                  'max-md:grid max-md:w-full max-md:grid-rows-[0fr] max-md:transition-[grid-template-rows] max-md:duration-300 max-md:group-data-open/item:grid-rows-[1fr]',
                  'md:invisible md:absolute md:top-full md:z-5 md:translate-y-2 md:pt-3.5 md:opacity-0 md:transition-[opacity,translate,visibility] md:duration-200',
                  'md:group-hover/item:visible md:group-hover/item:translate-y-0 md:group-hover/item:opacity-100',
                  'md:group-data-open/item:visible md:group-data-open/item:translate-y-0 md:group-data-open/item:opacity-100',
                  link.columns || link.groups ? 'md:left-1/2 md:-translate-x-1/2' : 'md:left-0',
                  link.groups && 'md:w-max',
                ]}
              >
                <div
                  class:list={[
                    'max-md:invisible max-md:ml-3.5 max-md:min-h-0 max-md:overflow-hidden max-md:border-l-2 max-md:border-line max-md:pl-2 max-md:transition-[visibility] max-md:duration-300 max-md:group-data-open/item:visible',
                    'md:grid md:rounded-card md:border md:border-t-3 md:border-line md:border-t-accent md:bg-white md:p-2 md:shadow-card',
                    link.columns && 'max-md:grid max-md:grid-cols-2 md:min-w-120 md:grid-cols-3',
                    link.groups && 'md:grid-cols-[repeat(3,max-content)] md:gap-x-2',
                    !link.columns && !link.groups && 'md:min-w-57.5',
                  ]}
                >
                  {link.groups?.map((group) => (
                    <div class="max-md:pb-1.5">
                      <a href={group.href} aria-current={current(group.href)} class={groupLinkClass}>
                        {group.label}
                      </a>
                      {group.children.map((child) =>
                        child.href ? (
                          <a href={child.href} aria-current={current(child.href)} class={subLinkClass}>
                            {child.label}
                          </a>
                        ) : (
                          <span class={subLabelClass}>{child.label}</span>
                        )
                      )}
                    </div>
                  ))}
                  {link.children?.map((child) =>
                    child.href ? (
                      <a href={child.href} aria-current={current(child.href)} class={subLinkClass}>
                        {child.label}
                      </a>
                    ) : (
                      <span class={subLabelClass}>{child.label}</span>
                    )
                  )}
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              aria-current={current(link.href)}
              class:list={[
                linkClass,
                'aria-[current=page]:bg-soft aria-[current=page]:text-accent md:aria-[current=page]:bg-transparent md:aria-[current=page]:text-white md:aria-[current=page]:after:scale-x-100',
              ]}
            >
              {link.label}
            </a>
          )
        )
      }

      <div class="mt-auto pt-3.5 md:hidden">
        <div class="border-t border-line pt-2.5">
          <a href={site.phone.href} class={contactClass}>
            <span class={contactIconClass}><Icon name="phone" class="size-3.5" /></span>
            {site.phone.display}
          </a>
          <a href={site.email.href} class={contactClass}>
            <span class={contactIconClass}><Icon name="mail" class="size-3.5" /></span>
            {site.email.display}
          </a>
          <SocialLinks variant="nav" class="mx-1 mt-2.5" />
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-5 max-md:hidden">
      <a href={site.phone.href} class="flex items-center gap-2 font-bold whitespace-nowrap text-white max-lg:hidden">
        <Icon name="phone" class="size-4.5 text-glow" />
        {site.phone.display}
      </a>
      <Button quote size="sm" class="hover:translate-y-0">Get Free Quote</Button>
    </div>
  </div>
  <span class="absolute inset-x-0 bottom-0 h-0.75 bg-heat-cool max-md:hidden" aria-hidden="true"></span>
</div>

<script>
  import '../../scripts/nav.ts';
</script>
